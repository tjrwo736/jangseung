#!/usr/bin/env python3
"""Repository-local Aegis launcher, also run by the Claude Code plugin.

It stays readable by old Pythons: the plugin's shell line starts ``python3``
once, and when that is older than 3.10 this exits with status 97 before reading
the hook input, so the shell can hand the same input to ``python`` instead.
Checking the version in a separate Python start cost a second interpreter launch
on every tool call.
"""

import os
import sys

_TOO_OLD = 97

if sys.version_info < (3, 10):
    if os.environ.get("JANGSEUNG_PYTHON_FALLBACK") != "1":
        sys.exit(_TOO_OLD)
    if sys.argv[1:2] == ["session-check"]:
        sys.stdout.write('{"systemMessage": "Jangseung needs Python 3.10 or later; every tool call is blocked until one is installed."}\n')
        sys.exit(0)
    sys.stdout.write(
        '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",'
        ' "permissionDecisionReason": "Jangseung needs Python 3.10 or later."}}\n'
    )
    sys.stderr.write("Jangseung needs Python 3.10 or later.\n")
    sys.exit(2)

# os.path rather than pathlib: pathlib loads about ten modules, read one file each,
# before jangseung.cli.entry.run can load them from the hook's import cache.
ROOT = os.path.dirname(os.path.realpath(__file__))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from jangseung.cli.entry import run  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(run(launcher=os.path.abspath(__file__)))
